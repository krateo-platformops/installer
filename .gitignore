# Helm build artifacts — deps are pulled from OCI at release time, never committed.
chart/charts/
chart/Chart.lock
*.tgz
dist/
__pycache__/

# kubectl's discovery/http cache. kubectl writes it to $HOME/.kube, but when HOME
# is unset or a tool runs with this repo as its working directory it lands HERE as
# ./.kube/cache — ~400 JSON files. Harmless content (API discovery, no credentials:
# the only "token" string is the serviceaccounts/token RESOURCE NAME), but it is not
# ours and a plain `git add .` would commit all of it into a shared repo.
.kube/

# A stray `config` was committed by `git add -A` on 2026-11-13 (installer#872): a
# 20k-line copy of chart/values.schema.json left behind by a failed edit attempt.
# It is not a credential -- it is the schema -- but 1MB of junk reached main and
# the 0.3.628 tag. Ignored so the same slip cannot repeat.
/config
